# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed for the Claude brain;
# without it Trencher runs on its rules-only brain.
ANTHROPIC_API_KEY=

# Brain: auto (Claude if a key is set) | claude | rules
BRAIN=auto
MODEL=claude-opus-5-5
EFFORT=medium
MAX_BRAIN_CALLS_PER_HOUR=10
WEB_RESEARCH=true

# Paper wallet
STARTING_CASH_USD=100
# Conviction (1-10) → % of equity you're willing to lose if the stop hits
CONVICTION_RISK_PCT=1:0,2:0,3:0,4:0,5:1,6:1.5,7:2.5,8:4,9:6,10:8
MAX_POSITION_PCT=25
MAX_TOTAL_RISK_PCT=15
MAX_OPEN_POSITIONS=4

# Push trades somewhere (all optional)
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
