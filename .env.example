# Copy to .env and fill in. Only ANTHROPIC_API_KEY is needed for the Claude brain;
# without it Trencher runs on its rules-only brain.
ANTHROPIC_API_KEY=

# Brain: auto (Claude if a key is set) | claude | rules
BRAIN=auto
MODEL=claude-opus-5-5
EFFORT=medium
MAX_BRAIN_CALLS_PER_HOUR=10
WEB_RESEARCH=true

# Paper wallet
STARTING_CASH_USD=100
# Conviction (1-10) → % of equity you're willing to lose if the stop hits
CONVICTION_RISK_PCT=1:0,2:0,3:0,4:0,5:1,6:1.5,7:2.5,8:4,9:6,10:8
MAX_POSITION_PCT=25
# 0 = unlimited
MAX_OPEN_POSITIONS=0
# Total at-stop risk across open trades. Default 25%, and Trencher evolves it (10-40%).
# Setting it here pins it and stops the evolution, same as any evolvable setting.
# MAX_TOTAL_RISK_PCT=25

# Web crawler (all optional)
# public alpha/caller channels, e.g. channel1,channel2
TELEGRAM_CHANNELS=
REDDIT_SUBS=memecoins,solana,CryptoMoonShots
CRAWL_WEBSITES=true
# raises GitHub's anonymous rate limit
GITHUB_TOKEN=

# Read-only JSON API for other bots (0 = off)
API_PORT=0
API_HOST=127.0.0.1
API_TOKEN=

# Push trades somewhere (all optional)
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
