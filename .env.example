# Copy to .env and fill in.
#
# The brain runs on your Claude Pro/Max plan through the Claude Code CLI, so there's
# no per-call bill. Run `claude setup-token` once on any machine logged in to your plan
# and paste the token here. (On a machine where you're already logged in to `claude`,
# you can leave it empty.)
CLAUDE_CODE_OAUTH_TOKEN=

# Brain: auto (your Claude plan if the `claude` CLI is installed, else the API key,
# else rules-only) | subscription | api | rules
BRAIN=auto
MODEL=claude-opus-5-5
EFFORT=medium
# Pacing for your plan's usage window, which you share with your own Claude use.
# 0 = no hourly cap: it runs until the plan's limit, then waits for the reset.
MAX_BRAIN_CALLS_PER_HOUR=30
WEB_RESEARCH=true
# Only for BRAIN=api (billed per token). Not used by the subscription brain.
ANTHROPIC_API_KEY=

# Paper wallet
STARTING_CASH_USD=100
# Conviction (1-10) → % of equity you're willing to lose if the stop hits
CONVICTION_RISK_PCT=1:0,2:0,3:0,4:0,5:1,6:1.5,7:2.5,8:4,9:6,10:8
MAX_POSITION_PCT=25
# 0 = unlimited
MAX_OPEN_POSITIONS=0
# Total at-stop risk across open trades. Default 25%, and Trencher evolves it (10-40%).
# Setting it here pins it and stops the evolution, same as any evolvable setting.
# MAX_TOTAL_RISK_PCT=25

# Web crawler (all optional)
# public alpha/caller channels, e.g. channel1,channel2
TELEGRAM_CHANNELS=
REDDIT_SUBS=memecoins,solana,CryptoMoonShots
CRAWL_WEBSITES=true
# raises GitHub's anonymous rate limit
GITHUB_TOKEN=

# Read-only JSON API for other bots (0 = off)
API_PORT=0
API_HOST=127.0.0.1
API_TOKEN=

# Push trades somewhere (all optional)
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
